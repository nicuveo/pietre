fn test1<T>(x: T) -> int {
   let y: S<_> = S@{ s: x };
   return y.s as int;
}

const c: int = 1 ^ 2;

fn foo(x: int, y: &int) -> int {
  return (y + 1);
}

fn bar(x: int, y: int) -> int {
  return foo(x, &x);
}

struct Pair { x: int, y: int }

fn baz(x: int) -> int {
  return 1 * 1 * (!!((1 < 2) && (1 < x))) as int + 0 + 0;
}

